# Part a: Create population vectors for 2000 and 2010, then combine into a 4x2 matrix\
a2000 <- c(4447100, 626932, 5130632, 2673400) [cite: 9, 11]\
a2010 <- c(4779735, 710231, 6329013, 2915921) [cite: 9, 11]\
\
pop_matrix <- cbind(a2000, a2010) [cite: 11]\
\
print("Initial population matrix:")\
print(pop_matrix)\
\
\
# Part b: Calculate the percentage increase vector using element extraction\
# Formula: (2010 value - 2000 value) / 2000 value\
perc_increase <- (pop_matrix[, 2] - pop_matrix[, 1]) / pop_matrix[, 1] [cite: 5, 12, 13, 14]\
\
print("Percentage increase vector:")\
print(perc_increase)\
\
\
# Part c: Predict the 2020 population vector using element extraction\
# Formula: 2010 value * (1 + percentage increase value)\
a2020 <- pop_matrix[, 2] * (1 + perc_increase) [cite: 15, 16]\
\
print("Estimated 2020 population vector:")\
print(a2020)\
\
\
# Part d: Add the 2020 vector to the matrix and overwrite the original matrix object\
pop_matrix <- cbind(pop_matrix, a2020) [cite: 17, 18]\
\
print("Final population matrix:")\
print(pop_matrix)}